API_ENV=development
API_PORT=8080
API_TIMEZONE=Asia/Bangkok
API_CORS_ALLOWED_ORIGINS=http://localhost:3000

WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
INTERNAL_API_URL=http://prasankit-api:8080

TENANT_RESOLUTION_MODE=path
DEV_TENANT_PATH_PREFIX=/w
APP_WEB_URL=http://localhost:3000
APP_DOMAIN=localhost

POSTGRES_EXTERNAL_PORT=15432
POSTGRES_PRIMARY_HOST=prasankit-pgsql
POSTGRES_PRIMARY_PORT=5432
POSTGRES_PRIMARY_USER=prasankit
POSTGRES_PRIMARY_PASSWORD=change_me
POSTGRES_PRIMARY_NAME=prasankit
POSTGRES_SSL_MODE=disable

REDIS_EXTERNAL_PORT=16379
REDIS_HOST=prasankit-redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_DB=0

MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ROOT_USER=prasankit
MINIO_ROOT_PASSWORD=change_me
STORAGE_ENDPOINT=http://prasankit-minio:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:19000
STORAGE_BUCKET=prasankit
STORAGE_PRESIGN_TTL=15m

MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=change_me
MAIL_SMTP_PASSWORD=change_me
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Prasankit
MAIL_VERIFY_BASE_URL=http://localhost:3000/auth/verify-email
MAIL_VERIFY_TOKEN_TTL=30m
MAIL_VERIFY_IP_LIMIT=5
MAIL_VERIFY_IP_WINDOW=10m
MAIL_VERIFY_EMAIL_SUBJECT=Verify your Prasankit account

SESSION_COOKIE_NAME=prasankit_session
SESSION_SECRET=change_me
SESSION_TTL=24h
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
