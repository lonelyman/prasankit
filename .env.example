API_ENV=development
# API_PORT = port the Go app listens on inside the container (container-internal).
# API_EXTERNAL_PORT = host port published by docker-compose. High port avoids clashes.
API_PORT=8080
API_EXTERNAL_PORT=18080
API_TIMEZONE=Asia/Bangkok
API_CORS_ALLOWED_ORIGINS=http://localhost:13000

# WEB_EXTERNAL_PORT = host port for the Next.js app (container listens on 3000).
WEB_EXTERNAL_PORT=13000
# Browser-facing API URL — must point at the API's host port (build-time, inlined by Next).
NEXT_PUBLIC_API_URL=http://localhost:18080

POSTGRES_EXTERNAL_PORT=15432
POSTGRES_PRIMARY_HOST=prasankit-pgsql
POSTGRES_PRIMARY_PORT=5432
POSTGRES_PRIMARY_USER=prasankit
POSTGRES_PRIMARY_PASSWORD=change_me
POSTGRES_PRIMARY_NAME=prasankit
POSTGRES_SSL_MODE=disable

REDIS_EXTERNAL_PORT=16379
REDIS_HOST=prasankit-redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_DB=0

MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ROOT_USER=prasankit
MINIO_ROOT_PASSWORD=change_me
STORAGE_ENDPOINT=http://prasankit-minio:9000
STORAGE_BUCKET=prasankit
